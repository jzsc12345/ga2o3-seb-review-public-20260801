# Zero-ATLAS RUN118 half of the frozen RUN096/RUN109 HEATMAP extraction.
# Only run/file prefixes differ from RUN096_109_2D_path_topology_heatmap.in.

go victoryextract
option ON.ERROR=-1
option DIGITS=9

load in=/root/DECKBUILD/runs/RUN118_wang1000-fvsatt-short500ns/RUN118_Wang2026_nofp_Lgd9_x11_fvsatT_SEB_1000V_Et0p8_t50ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_118_2d_topology_20260731/raw/RUN118_t50ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_118_2d_topology_20260731/raw/RUN118_t50ns_substrate.csv

load in=/root/DECKBUILD/runs/RUN118_wang1000-fvsatt-short500ns/RUN118_Wang2026_nofp_Lgd9_x11_fvsatT_SEB_1000V_Et0p8_t100ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_118_2d_topology_20260731/raw/RUN118_t100ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_118_2d_topology_20260731/raw/RUN118_t100ns_substrate.csv

load in=/root/DECKBUILD/runs/RUN118_wang1000-fvsatt-short500ns/RUN118_Wang2026_nofp_Lgd9_x11_fvsatT_SEB_1000V_Et0p8_t500ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_118_2d_topology_20260731/raw/RUN118_t500ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_118_2d_topology_20260731/raw/RUN118_t500ns_substrate.csv

quit
