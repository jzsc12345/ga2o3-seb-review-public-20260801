# Zero-ATLAS persistent-current-path audit for the frozen RUN108 baseline.
#
# Purpose:
#   Compare the channel, UID, shallow/deep Fe substrate, and three vertical
#   connection cuts at matched transient milestones.  This deck only reads
#   existing RUN108 .str files and writes lightweight CSV profiles.  It does
#   not solve ATLAS and does not modify the frozen RUN108 lineage.
#
# Wang-path mapping:
#   shallow path: gate-right -> shallow substrate -> channel -> drain
#   deep path:    source -> gate-left -> deep substrate -> drain
#
# Horizontal cuts:
#   channel y=0.075 um, UID y=0.25 um,
#   shallow substrate y=0.36 um, deep substrate y=2.85 um.
# Vertical cuts:
#   gate-left x=4.875 um, gate-right x=9.125 um,
#   ion track x=11 um, drain connection x=18 um.

go victoryextract
option ON.ERROR=-1
option DIGITS=9

# -----------------------------------------------------------------------------
# Pre-strike, electrothermal 1000 V baseline
# -----------------------------------------------------------------------------
load in=/root/DECKBUILD/runs/RUN108_ndsub1p15e16-seb1000/RUN108_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_prestrike.str
extract.profile axis=x y.val=0.075 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_h_channel.csv
extract.profile axis=x y.val=0.25 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_h_uid.csv
extract.profile axis=x y.val=0.36 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_h_subtop.csv
extract.profile axis=x y.val=2.85 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_h_submid.csv
extract.profile axis=y x.val=4.875 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_v_gateleft.csv
extract.profile axis=y x.val=9.125 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_v_gateright.csv
extract.profile axis=y x.val=11.0 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_v_strike.csv
extract.profile axis=y x.val=18.0 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN108_persistent_path_audit_20260731/prestrike_v_drain.csv

# -----------------------------------------------------------------------------
# 100 ps: early high-current phase
