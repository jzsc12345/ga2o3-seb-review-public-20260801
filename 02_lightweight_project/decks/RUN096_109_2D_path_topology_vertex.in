# Zero-ATLAS native-vertex sensitivity extraction for the 2-D path audit.
#
# EXTRACT.VERTEX.CONCENTRATION exports the field values on the STR vertices
# instead of interpolating them to a HEATMAP grid.  The box is deliberately
# limited to the active channel + UID slab used by the reconstructed path.

go victoryextract
option ON.ERROR=-1
option DIGITS=9

load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t50ns.str
extract.vertex.concentration regions=* box.pa="2.0,0.0" box.pb="18.0,0.35" \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_vertex_20260731/raw/RUN096_t50ns_vertex.csv

load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t100ns.str
extract.vertex.concentration regions=* box.pa="2.0,0.0" box.pb="18.0,0.35" \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_vertex_20260731/raw/RUN096_t100ns_vertex.csv

load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t500ns.str
extract.vertex.concentration regions=* box.pa="2.0,0.0" box.pb="18.0,0.35" \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_vertex_20260731/raw/RUN096_t500ns_vertex.csv

load in=/root/DECKBUILD/runs/RUN109_ndsub5e15-seb1000/RUN109_Wang2026_nofp_Lgd9_x11_subNd5e15_fulltrack_SEB_1000V_Et0p8_t50ns.str
extract.vertex.concentration regions=* box.pa="2.0,0.0" box.pb="18.0,0.35" \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_vertex_20260731/raw/RUN109_t50ns_vertex.csv

load in=/root/DECKBUILD/runs/RUN109_ndsub5e15-seb1000/RUN109_Wang2026_nofp_Lgd9_x11_subNd5e15_fulltrack_SEB_1000V_Et0p8_t100ns.str
extract.vertex.concentration regions=* box.pa="2.0,0.0" box.pb="18.0,0.35" \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_vertex_20260731/raw/RUN109_t100ns_vertex.csv

load in=/root/DECKBUILD/runs/RUN109_ndsub5e15-seb1000/RUN109_Wang2026_nofp_Lgd9_x11_subNd5e15_fulltrack_SEB_1000V_Et0p8_t500ns.str
extract.vertex.concentration regions=* box.pa="2.0,0.0" box.pb="18.0,0.35" \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_vertex_20260731/raw/RUN109_t500ns_vertex.csv

quit
