# Zero-ATLAS 2-D current-path topology extraction.
#
# Reads the frozen RUN096 and completed RUN109 snapshots at matched
# 50 ns / 100 ns / 500 ns.  EXTRACT.HEATMAP exports a fixed regular grid,
# so every paired CSV uses identical coordinates.  No ATLAS statement,
# solve, material, model, mesh, or physical parameter appears in this deck.
#
# Two grids are used:
#   shallow: channel + UID,  dx=0.02 um, dy=0.005 um
#   substrate: Fe substrate, dx=0.05 um, dy=0.05 um
#
# Extracted fields:
#   electron conc, Je,x, Je,y, |Jtotal|, impact generation rate.

go victoryextract
option ON.ERROR=-1
option DIGITS=9

# -----------------------------------------------------------------------------
# RUN096, Nd_sub=1.5e15 cm^-3
# -----------------------------------------------------------------------------
load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t50ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN096_t50ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN096_t50ns_substrate.csv

load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t100ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN096_t100ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN096_t100ns_substrate.csv

load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t500ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN096_t500ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN096_t500ns_substrate.csv

# -----------------------------------------------------------------------------
# RUN109, Nd_sub=5.0e15 cm^-3
# -----------------------------------------------------------------------------
load in=/root/DECKBUILD/runs/RUN109_ndsub5e15-seb1000/RUN109_Wang2026_nofp_Lgd9_x11_subNd5e15_fulltrack_SEB_1000V_Et0p8_t50ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN109_t50ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN109_t50ns_substrate.csv

load in=/root/DECKBUILD/runs/RUN109_ndsub5e15-seb1000/RUN109_Wang2026_nofp_Lgd9_x11_subNd5e15_fulltrack_SEB_1000V_Et0p8_t100ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN109_t100ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN109_t100ns_substrate.csv

load in=/root/DECKBUILD/runs/RUN109_ndsub5e15-seb1000/RUN109_Wang2026_nofp_Lgd9_x11_subNd5e15_fulltrack_SEB_1000V_Et0p8_t500ns.str
extract.heatmap dx="0.02,0.005" mode=fixed group=sparse \
    box.pa="0.0,0.0" box.pb="20.0,0.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN109_t500ns_shallow.csv
extract.heatmap dx="0.05,0.05" mode=fixed group=sparse \
    box.pa="0.0,0.35" box.pb="20.0,5.35" regions=* \
    fields="electron conc","je- x","je- y","total current density","impact gen rate" \
    csvfile=/root/DECKBUILD/postproc/RUN096_109_2d_topology_20260731/raw/RUN109_t500ns_substrate.csv

quit
