# Zero-ATLAS 1 us heat-source comparison; both milestone STR files exist.
go victoryextract
option ON.ERROR=-1
option DIGITS=12

load in=/root/DECKBUILD/runs/RUN094_wang1000-nofp-lgd9-x11-reference/RUN094_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t1us.str
extract.region.concentration name=R094_PJ regions=* field="joule heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PJ_t1us.result
extract.region.concentration name=R094_PGR regions=* field="rec heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PGR_t1us.result
extract.region.concentration name=R094_PPT regions=* field="peltier-thomson heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PPT_t1us.result
extract.region.concentration name=R094_PTOT regions=* field="total heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PTOT_t1us.result

load in=/root/DECKBUILD/runs/RUN095_wang1000-nofp-lgd9-x11-heatfull/RUN095_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t1us.str
extract.region.concentration name=R095_PJ regions=* field="joule heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R095_PJ_t1us.result
extract.region.concentration name=R095_PGR regions=* field="rec heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R095_PGR_t1us.result
extract.region.concentration name=R095_PPT regions=* field="peltier-thomson heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R095_PPT_t1us.result
extract.region.concentration name=R095_PTOT regions=* field="total heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R095_PTOT_t1us.result

quit
