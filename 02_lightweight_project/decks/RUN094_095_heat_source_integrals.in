# Zero-ATLAS heat-source audit for matched RUN094/RUN095 milestones.
# RUN094 = frozen Wang geometry with the default Joule source.
# RUN095 = identical deck except HEAT.FULL + JOULE/GR/PT heat sources.
# Each EXTRACT.REGION.CONCENTRATION is a 2-D volume integral with WIDTH=1 um.
go victoryextract
option ON.ERROR=-1
option DIGITS=12

# -----------------------------------------------------------------------------
# RUN094 reference arm
# -----------------------------------------------------------------------------
load in=/root/DECKBUILD/runs/RUN094_wang1000-nofp-lgd9-x11-reference/RUN094_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t100ps.str
extract.region.concentration name=R094_PJ_t100ps regions=* field="joule heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PJ_t100ps.result
extract.region.concentration name=R094_PGR_t100ps regions=* field="rec heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PGR_t100ps.result
extract.region.concentration name=R094_PPT_t100ps regions=* field="peltier-thomson heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PPT_t100ps.result
extract.region.concentration name=R094_PTOT_t100ps regions=* field="total heat power" width=1 datafile=/root/DECKBUILD/postproc/RUN094_095_heat_sources/R094_PTOT_t100ps.result

load in=/root/DECKBUILD/runs/RUN094_wang1000-nofp-lgd9-x11-reference/RUN094_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t400ps.str
