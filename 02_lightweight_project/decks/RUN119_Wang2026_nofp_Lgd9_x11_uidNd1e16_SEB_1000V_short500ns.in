# =============================================================================
# RUN119 -- UID donor 2x sensitivity arm, frozen from RUN096
#
# A13 contract:
#   The only physical change is Nd_UID 5.0e15 -> 1.0e16 cm^-3.
#   UID thickness remains 0.20 um. Geometry, mesh commands, channel/substrate
#   doping, Fe trap, materials, constant VSAT, impact, thermal model/boundary,
#   ion source, solver, VDS and every time step through 500 ns are frozen.
#   The 1-100 us execution tail is omitted; output names are mechanically
#   isolated under RUN119. No interface charge/trap/barrier is added.
#
# Production baseline:
#   source workspace deck directory (path removed from review copy)
#   RUN096_Wang2026_nofp_Lgd9_x11_hfo2hc_SEB_1000V_Et0p8_long.in
#   SHA-256 786EA68542AA235621A2A2AD13DC81CB86666FD875577F00FF1FBFA5143D7CB5
#
# Authorization state:
#   Deck/A14 preparation authorized 2026-07-31. Upload and launch are NOT
#   authorized. Candidate mesh topology remains unverified until a separate
#   DevEdit-only preflight is explicitly approved and executed.
# =============================================================================

set x_dev       = 20.0
set x_src_r     = 2.0
set x_src_imp_r = 3.0
set x_gate_l    = 5.0
set x_gate_r    = 9.0
set x_drn_imp_l = 17.0
set x_drn_l     = 18.0

set y_sio2_top  = -0.42
set y_hfo2_top  = -0.02
set y_surface   = 0.00
set y_channel_b = 0.15
set y_buffer_b  = 0.35
set y_sub_b     = 5.35

set nd_channel  = 5.0e16
set nd_uid      = 1.0e16
set nd_sd       = 1.0e19
set nd_sub      = 1.5e15
set nt_fe       = 2.0e18
set et_fe       = 0.8
set sig_fe      = 5.0e-15

set eg_g        = 4.85
set chi_g       = 4.00
set eps_g       = 10.2
set nc_g        = 3.718e18
set nv_g        = 6.44e20
set mun_g       = 118.0
set mup_g       = 1.3
set tau_g       = 1.2e-8
set kappa_g     = 0.27
set heatcap_g   = 3.332
set alpha_top   = 1000.0
set alpha_bot   = 3.0

set target_vds  = 1000.0
set xion        = 11.0
set ion_radius  = 0.05
set ion_roi_l   = $xion-3*$ion_radius
set ion_roi_r   = $xion+3*$ion_radius
set ion_dx      = 0.012
set ion_dy_epi  = 0.012
set ion_dy_sub  = 0.10
set qline       = 0.4529
set ion_t0      = 10e-12
set ion_tc      = 2e-12

set wf_source   = 4.00
set wf_drain    = 4.00
set wf_gate     = 5.78

# -----------------------------------------------------------------------------
# Stage 1: frozen RUN096 zero-area-electrode structure and mesh commands
# -----------------------------------------------------------------------------
go devedit

work.area x1=0.0 y1=$y_sio2_top x2=$x_dev y2=$y_sub_b

region id=1 name=passivation material=SiO2 \
       points="0,$y_sio2_top $x_dev,$y_sio2_top \
               $x_dev,$y_hfo2_top 0,$y_hfo2_top 0,$y_sio2_top"
region id=2 name=gate_oxide material=HfO2 \
       points="0,$y_hfo2_top $x_dev,$y_hfo2_top \
               $x_dev,$y_surface 0,$y_surface 0,$y_hfo2_top"

region id=3 name=source_implant material="UD1(BetaGa2O3)" \
       points="0,$y_surface $x_src_imp_r,$y_surface \
               $x_src_imp_r,$y_channel_b 0,$y_channel_b 0,$y_surface"
region id=4 name=channel material="UD1(BetaGa2O3)" \
       points="$x_src_imp_r,$y_surface $x_drn_imp_l,$y_surface \
               $x_drn_imp_l,$y_channel_b $x_src_imp_r,$y_channel_b \
               $x_src_imp_r,$y_surface"
region id=5 name=drain_implant material="UD1(BetaGa2O3)" \
       points="$x_drn_imp_l,$y_surface $x_dev,$y_surface \
               $x_dev,$y_channel_b $x_drn_imp_l,$y_channel_b \
               $x_drn_imp_l,$y_surface"
region id=6 name=uid_buffer material="UD1(BetaGa2O3)" \
       points="0,$y_channel_b $x_dev,$y_channel_b \
               $x_dev,$y_buffer_b 0,$y_buffer_b 0,$y_channel_b"
region id=7 name=substrate material="UD1(BetaGa2O3)" \
       points="0,$y_buffer_b $x_dev,$y_buffer_b \
               $x_dev,$y_sub_b 0,$y_sub_b 0,$y_buffer_b"

region id=8 name=source material=Aluminum elec.id=1 \
       points="0,$y_surface $x_src_r,$y_surface"
region id=9 name=drain material=Aluminum elec.id=2 \
       points="$x_drn_l,$y_surface $x_dev,$y_surface"
region id=10 name=gate material=Aluminum elec.id=3 \
       points="$x_gate_l,$y_hfo2_top $x_gate_r,$y_hfo2_top"
impurity id=1 region.id=3 imp=Donors peak.value=$nd_sd \
         ref.value=1.0e12 comb.func=Multiply
impurity id=2 region.id=4 imp=Donors peak.value=$nd_channel \
         ref.value=1.0e12 comb.func=Multiply
impurity id=3 region.id=5 imp=Donors peak.value=$nd_channel \
         ref.value=1.0e12 comb.func=Multiply
impurity id=4 region.id=6 imp=Donors peak.value=$nd_uid \
         ref.value=1.0e12 comb.func=Multiply
impurity id=5 region.id=7 imp=Donors peak.value=$nd_sub \
         ref.value=1.0e12 comb.func=Multiply

base.mesh height=0.60 width=0.90
bound.cond !apply max.slope=30 max.ratio=50 rnd.unit=0.001 \
           line.straightening=0 align.points when=automatic
imp.refine min.spacing=0.020
constr.mesh max.angle=90 max.ratio=40 \
            max.height=0.60 max.width=0.60 \
            min.height=0.001 min.width=0.001

constr.mesh reg=1 max.height=0.075
constr.mesh reg=2 max.height=0.005
constr.mesh reg=3 max.height=0.022
constr.mesh reg=4 max.height=0.022
constr.mesh reg=5 max.height=0.022
constr.mesh reg=6 max.height=0.045
constr.mesh reg=7 max.height=0.60

# Resolve the frozen radial source with dx < radius/3. The along-track source
# is uniform; the 5 um substrate uses a coarser 0.10 um vertical pitch while
# channel+UID retain the RUN034 0.012 um pitch.
constr.mesh x1=$ion_roi_l y1=$y_surface x2=$ion_roi_r y2=$y_buffer_b \
            max.height=$ion_dy_epi max.width=$ion_dx
constr.mesh x1=$ion_roi_l y1=$y_buffer_b x2=$ion_roi_r y2=$y_sub_b \
            max.height=$ion_dy_sub max.width=$ion_dx

mesh mode=MeshBuild
structure outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_mesh.str"

# -----------------------------------------------------------------------------
# Stage 2: frozen RUN096 equations; only Nd_UID differs in Stage 1
# -----------------------------------------------------------------------------
go atlas simflags="-V 5.40.0.R -P 4"
mesh infile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_mesh.str"

doping gauss n.type conc=$nd_sd char=1.0 lat.char=1.0 \
       x.min=$x_drn_l y.min=$y_surface y.max=$y_channel_b

material region=3 user.group=semiconductor user.default=GaN \
         affinity=$chi_g eg300=$eg_g egalph=0 egbeta=0 \
         permittivity=$eps_g nc300=$nc_g nv300=$nv_g \
         taun0=$tau_g taup0=$tau_g \
         edb=0.06 gcb=2.0 eab=1.0 gvb=4.0 \
         augn=2.8e-31 augp=9.9e-32 \
         tcon.const tc.const=$kappa_g \
         hc.std hc.a=$heatcap_g hc.b=0 hc.c=0 hc.d=0
material region=4 user.group=semiconductor user.default=GaN \
         affinity=$chi_g eg300=$eg_g egalph=0 egbeta=0 \
         permittivity=$eps_g nc300=$nc_g nv300=$nv_g \
         taun0=$tau_g taup0=$tau_g \
         edb=0.06 gcb=2.0 eab=1.0 gvb=4.0 \
         augn=2.8e-31 augp=9.9e-32 \
         tcon.const tc.const=$kappa_g \
         hc.std hc.a=$heatcap_g hc.b=0 hc.c=0 hc.d=0
material region=5 user.group=semiconductor user.default=GaN \
         affinity=$chi_g eg300=$eg_g egalph=0 egbeta=0 \
         permittivity=$eps_g nc300=$nc_g nv300=$nv_g \
         taun0=$tau_g taup0=$tau_g \
         edb=0.06 gcb=2.0 eab=1.0 gvb=4.0 \
         augn=2.8e-31 augp=9.9e-32 \
         tcon.const tc.const=$kappa_g \
         hc.std hc.a=$heatcap_g hc.b=0 hc.c=0 hc.d=0
material region=6 user.group=semiconductor user.default=GaN \
         affinity=$chi_g eg300=$eg_g egalph=0 egbeta=0 \
         permittivity=$eps_g nc300=$nc_g nv300=$nv_g \
         taun0=$tau_g taup0=$tau_g \
         edb=0.06 gcb=2.0 eab=1.0 gvb=4.0 \
         augn=2.8e-31 augp=9.9e-32 \
         tcon.const tc.const=$kappa_g \
         hc.std hc.a=$heatcap_g hc.b=0 hc.c=0 hc.d=0
material region=7 user.group=semiconductor user.default=GaN \
         affinity=$chi_g eg300=$eg_g egalph=0 egbeta=0 \
         permittivity=$eps_g nc300=$nc_g nv300=$nv_g \
         taun0=$tau_g taup0=$tau_g \
         edb=0.06 gcb=2.0 eab=1.0 gvb=4.0 \
         augn=2.8e-31 augp=9.9e-32 \
         tcon.const tc.const=$kappa_g \
         hc.std hc.a=$heatcap_g hc.b=0 hc.c=0 hc.d=0

material region=1 permittivity=3.9 \
         tcon.const tc.const=0.014
material region=2 permittivity=25.0 \
         tcon.const tc.const=0.023 \
         hc.std hc.a=4.0 hc.b=4.5e-4 hc.c=0.0 hc.d=-1.1e4

mobility region=3 mu1n.caug=10 mu2n.caug=$mun_g \
         ncritn.caug=2e17 deltan.caug=1.0 \
         alphan.caug=0 betan.caug=0 gamman.caug=0 \
         mu1p.caug=1e-6 mu2p.caug=$mup_g \
         ncritp.caug=1e17 deltap.caug=1.0 \
         alphap.caug=0 betap.caug=0 gammap.caug=0 \
         vsatn=2.0e7 vsatp=2.0e7 betan=7.52 betap=7.52
mobility region=4 mu1n.caug=10 mu2n.caug=$mun_g \
         ncritn.caug=2e17 deltan.caug=1.0 \
         alphan.caug=0 betan.caug=0 gamman.caug=0 \
         mu1p.caug=1e-6 mu2p.caug=$mup_g \
         ncritp.caug=1e17 deltap.caug=1.0 \
         alphap.caug=0 betap.caug=0 gammap.caug=0 \
         vsatn=2.0e7 vsatp=2.0e7 betan=7.52 betap=7.52
mobility region=5 mu1n.caug=10 mu2n.caug=$mun_g \
         ncritn.caug=2e17 deltan.caug=1.0 \
         alphan.caug=0 betan.caug=0 gamman.caug=0 \
         mu1p.caug=1e-6 mu2p.caug=$mup_g \
         ncritp.caug=1e17 deltap.caug=1.0 \
         alphap.caug=0 betap.caug=0 gammap.caug=0 \
         vsatn=2.0e7 vsatp=2.0e7 betan=7.52 betap=7.52
mobility region=6 mu1n.caug=10 mu2n.caug=$mun_g \
         ncritn.caug=2e17 deltan.caug=1.0 \
         alphan.caug=0 betan.caug=0 gamman.caug=0 \
         mu1p.caug=1e-6 mu2p.caug=$mup_g \
         ncritp.caug=1e17 deltap.caug=1.0 \
         alphap.caug=0 betap.caug=0 gammap.caug=0 \
         vsatn=2.0e7 vsatp=2.0e7 betan=7.52 betap=7.52
mobility region=7 mu1n.caug=10 mu2n.caug=$mun_g \
         ncritn.caug=2e17 deltan.caug=1.0 \
         alphan.caug=0 betan.caug=0 gamman.caug=0 \
         mu1p.caug=1e-6 mu2p.caug=$mup_g \
         ncritp.caug=1e17 deltap.caug=1.0 \
         alphap.caug=0 betap.caug=0 gammap.caug=0 \
         vsatn=2.0e7 vsatp=2.0e7 betan=7.52 betap=7.52

impact region=3 selb an1=2.16e6 an2=2.16e6 bn1=1.77e7 bn2=1.77e7 \
       ap1=2.16e6 ap2=2.16e6 bp1=1.77e7 bp2=1.77e7 \
       betan=1.0 betap=1.0 egran=4.0e5
impact region=4 selb an1=2.16e6 an2=2.16e6 bn1=1.77e7 bn2=1.77e7 \
       ap1=2.16e6 ap2=2.16e6 bp1=1.77e7 bp2=1.77e7 \
       betan=1.0 betap=1.0 egran=4.0e5
impact region=5 selb an1=2.16e6 an2=2.16e6 bn1=1.77e7 bn2=1.77e7 \
       ap1=2.16e6 ap2=2.16e6 bp1=1.77e7 bp2=1.77e7 \
       betan=1.0 betap=1.0 egran=4.0e5
impact region=6 selb an1=2.16e6 an2=2.16e6 bn1=1.77e7 bn2=1.77e7 \
       ap1=2.16e6 ap2=2.16e6 bp1=1.77e7 bp2=1.77e7 \
       betan=1.0 betap=1.0 egran=4.0e5
impact region=7 selb an1=2.16e6 an2=2.16e6 bn1=1.77e7 bn2=1.77e7 \
       ap1=2.16e6 ap2=2.16e6 bp1=1.77e7 bp2=1.77e7 \
       betan=1.0 betap=1.0 egran=4.0e5

# Physical Fe acceptor trap. REGION is numeric so the trap cannot spill into
# channel/UID regions that share the same user material.
trap region=7 acceptor e.level=$et_fe density=$nt_fe \
     degen.fac=1 sign=$sig_fe sigp=$sig_fe

contact name=source workfunc=$wf_source
contact name=drain workfunc=$wf_drain
contact name=gate workfunc=$wf_gate

# Wang reports thermal contacts on metal electrodes but does not report their
# resistance or ambient. The finite-alpha values below are project surrogates.
thermcontact number=1 elec.number=1 ext.temper=300 alpha=$alpha_top
thermcontact number=2 elec.number=2 ext.temper=300 alpha=$alpha_top
thermcontact number=3 x.min=0 x.max=$x_dev \
       y.min=$y_sub_b y.max=$y_sub_b ext.temper=300 alpha=$alpha_bot

probe name=Field_GateRight field dir=270 x=$x_gate_r y=0.005
probe name=Field_DrainEdge field dir=270 x=$x_drn_l y=0.005
probe name=ImpactMax generation max
probe name=HoleMax p.conc max

models analytic fldmob srh auger fermi incomplete print
method newton trap maxtraps=10 climit=1e-4 itlimit=50
output e.field impact flowlines e.mobility h.mobility band.param \
       l.temper ex.field ey.field photogen \
       jx.electron jy.electron jx.hole jy.hole jx.total jy.total

solve init
solve vgate=0 name=gate
log outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_static.log"
solve vdrain=0.1 name=drain
solve name=drain vstep=0.5 vfinal=10 previous
solve name=drain vstep=5.0 vfinal=$target_vds previous \
      compliance=1.6e-5 cname=drain
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_isothermal.str"
log off

# Turn on the complete thermal equation in the same ATLAS process, preserving
# the converged 1000 V electrical state and avoiding a DevEdit master reload.
models analytic fldmob srh auger fermi incomplete print lat.temp heat.full joule.heat gr.heat pt.heat
probe name=Tmax lat.temp max
probe name=Tmin lat.temp min
probe name=JouleMax joule.heat max
probe name=HeatMax total.heat max
probe name=Tsource lat.temp x=1.0 y=$y_surface
probe name=Tdrain lat.temp x=19.0 y=$y_surface
probe name=Tbottom lat.temp x=10.0 y=$y_sub_b
method block newton trap maxtraps=10 climit=1e-4 itlimit=50 max.temp=5000

solve previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_prestrike.str"

singleeventupset entrypoint="$xion,$y_surface" exitpoint="$xion,$y_sub_b" \
                 radialgauss b.density=$qline pcunits radius=$ion_radius \
                 t0=$ion_t0 tc=$ion_tc
probe integrated photogen name="GSEU_all" \
      x.min=0 x.max=$x_dev y.min=$y_sio2_top y.max=$y_sub_b

log outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_transient.log"
solve tstop=2e-12 dt=2e-13 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t2ps.str"
solve tstop=6e-12 dt=1e-13 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t6ps.str"
solve tstop=9.8e-12 dt=1e-13 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t9p8ps.str"
solve tstop=14e-12 dt=1e-13 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t14ps.str"
solve tstop=20e-12 dt=2e-13 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t20ps.str"

# Short diagnostic window. The RUN096 schedule is frozen through 500 ns;
# the 1-100 us execution tail is intentionally omitted by the RUN119 contract.
solve tstop=30e-12 dt=1e-12 previous
solve tstop=50e-12 dt=1e-12 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t50ps.str"
solve tstop=100e-12 dt=1e-11 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t100ps.str"
solve tstop=400e-12 dt=1e-11 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t400ps.str"
solve tstop=1e-9 dt=1e-11 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t1ns.str"
solve tstop=2e-9 dt=1e-9 previous
solve tstop=3e-9 dt=1e-9 previous
solve tstop=4e-9 dt=1e-9 previous
solve tstop=7e-9 dt=1e-9 previous
solve tstop=9e-9 dt=1e-9 previous
solve tstop=10e-9 dt=1e-9 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t10ns.str"
solve tstop=20e-9 dt=1e-8 previous
solve tstop=30e-9 dt=1e-8 previous
solve tstop=40e-9 dt=1e-8 previous
solve tstop=50e-9 dt=1e-8 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t50ns.str"
solve tstop=100e-9 dt=1e-8 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t100ns.str"
solve tstop=500e-9 dt=1e-8 previous
save outfile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_t500ns.str"
log off

extract init infile="RUN119_Wang2026_nofp_Lgd9_x11_uidNd1e16_SEB_1000V_transient.log"
# 2-D area integral has units cm^-1; multiply by 1e-4 cm for a 1 um width.
extract name="AreaTimeInt_cmInv_RUN119" area from curve(time, probe."GSEU_all")

quit
