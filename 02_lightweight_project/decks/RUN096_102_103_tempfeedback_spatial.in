# Zero-ATLAS spatial comparison for temperature-feedback OFAT.
# RUN096 = frozen constant-Eg / constant low-field mobility-temperature baseline.
# RUN102 = Rafique-anchored Eg(T) only.
# RUN103 = Ma-anchored active-body electron low-field mobility(T) only.
go victoryextract
option ON.ERROR=-1
option DIGITS=9

# Four matched cuts:
#   hfo2      y=-0.01 um
#   interface y=+0.01 um
#   uidsub    y=+0.35 um
#   track     x=11 um

# -----------------------------------------------------------------------------
# 100 ps
# -----------------------------------------------------------------------------
load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t100ps.str
extract.profile axis=x y.val=-0.01 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN096_102_103_tempfeedback/R096_t100ps_hfo2.csv
extract.profile axis=x y.val=0.01 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN096_102_103_tempfeedback/R096_t100ps_interface.csv
extract.profile axis=x y.val=0.35 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN096_102_103_tempfeedback/R096_t100ps_uidsub.csv
extract.profile axis=y x.val=11.0 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN096_102_103_tempfeedback/R096_t100ps_track.csv
load in=/root/DECKBUILD/runs/RUN102_wang1000-nofp-lgd9-x11-bandt-rafique/RUN102_Wang2026_nofp_Lgd9_x11_bandT_Rafique_SEB_1000V_Et0p8_t100ps.str
