# Zero-ATLAS matched spatial audit for the HfO2 heat-capacity single-variable test.
# RUN095 = HEAT.FULL with HfO2 Cap.Model=NONE.
# RUN096 = identical deck plus verified HfO2 HC.STD.
# Run only after RUN096 has produced all four named STR files.
go victoryextract
option ON.ERROR=-1
option DIGITS=9

# For every matched state:
#   hfo2      : x-cut through the 20 nm HfO2 at y=-0.01 um
#   interface : x-cut 10 nm inside Ga2O3 at y=+0.01 um
#   track     : y-cut along the ion trajectory at x=11 um

load in=/root/DECKBUILD/runs/RUN095_wang1000-nofp-lgd9-x11-heatfull/RUN095_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t100ps.str
extract.profile axis=x y.val=-0.01 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN095_096_hfo2hc/R095_t100ps_hfo2.csv
extract.profile axis=x y.val=0.01 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN095_096_hfo2hc/R095_t100ps_interface.csv
extract.profile axis=y x.val=11.0 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN095_096_hfo2hc/R095_t100ps_track.csv
load in=/root/DECKBUILD/runs/RUN096_wang1000-nofp-lgd9-x11-hfo2hc/RUN096_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t100ps.str
