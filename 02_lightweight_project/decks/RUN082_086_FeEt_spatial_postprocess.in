extract.profile axis=x y.val=0.200 fields=* regions=* csvfile="E06_et2400_y_p0p200_all.csv"
extract.profile axis=x y.val=0.400 fields=* regions=* csvfile="E06_et2400_y_p0p400_all.csv"
extract.profile axis=y x.val=11.000 fields=* regions=* csvfile="E06_et2400_x_11_all.csv"

load in="/root/DECKBUILD/runs/RUN085_fe-et0p6-staticet/RUN085_Wang2026_LGD20p0_FP11_subFe_Et0p6_staticET_V2600.str"
extract.profile axis=x y.val=0.010 fields=* regions=* csvfile="E06_et2600_y_p0p010_all.csv"
