# VictoryExtract-only voltage evolution audit for RUN082/RUN083/RUN084.
# No ATLAS solve is present in this deck.
#
# Frozen states common to all three Fe Nt points:
#   iso1600 : isothermal branch at VDS=1600 V
#   iso2400 : isothermal branch at VDS=2400 V
#   et2400  : electrothermal branch immediately after LAT.TEMP activation, VDS=2400 V
#   et2600  : electrothermal branch at VDS=2600 V
#
# Frozen cutlines:
#   y=0.010 um : channel
#   y=0.200 um : UID middle
#   y=0.400 um : substrate top
#   y=3.000 um : substrate middle
#   x=11.000 um : field-plate endpoint vertical line
#   x=26.2422 um : common 2600 V impact hotspot vertical line
#
# fields=* is intentional: it uses the already verified STR field registry and
# avoids speculative multi-field spelling. Python selects ionized acceptor
# concentration, electron conc, potential and total current density afterwards.

go victoryextract
option ON.ERROR=-1
option DIGITS=9

# ===========================================================================
# N1: Fe Nt=1e18 cm^-3
# ===========================================================================

load in="/root/DECKBUILD/runs/RUN083_fe-nt1e18-staticet/RUN083_Wang2026_LGD20p0_FP11_subFe_Nt1e18_isothermal_V1600.str"
extract.profile axis=x y.val=0.010 fields=* regions=* csvfile="N1_iso1600_y_p0p010_all.csv"
extract.profile axis=x y.val=0.200 fields=* regions=* csvfile="N1_iso1600_y_p0p200_all.csv"
extract.profile axis=x y.val=0.400 fields=* regions=* csvfile="N1_iso1600_y_p0p400_all.csv"
extract.profile axis=x y.val=3.000 fields=* regions=* csvfile="N1_iso1600_y_p3p000_all.csv"
extract.profile axis=y x.val=11.000 fields=* regions=* csvfile="N1_iso1600_x_11_all.csv"
extract.profile axis=y x.val=26.2422 fields=* regions=* csvfile="N1_iso1600_x_26p2422_all.csv"

load in="/root/DECKBUILD/runs/RUN083_fe-nt1e18-staticet/RUN083_Wang2026_LGD20p0_FP11_subFe_Nt1e18_isothermal_V2400.str"
