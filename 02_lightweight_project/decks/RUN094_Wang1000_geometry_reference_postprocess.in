# RUN092 long-Lgd/FP11 versus RUN094 Wang 20um/no-FP/Lgd9 comparison.
# Read-only VictoryExtract post-processing; no ATLAS solve.
go victoryextract
option ON.ERROR=-1
option DIGITS=9

# At each matched time extract:
#   surface: channel/UID near-interface path, y=0.01 um
#   uid_sub: UID/substrate interface path, y=0.35 um
#   track:   full-depth strike line, x=11 um
# fields=* is intentional: it keeps the evidence reusable without rerunning ATLAS.

load in=/root/DECKBUILD/runs/RUN092_wang1000-x11-align-diagnostic/RUN092_Wang2026_x11_fulltrack_SEB_1000V_Et0p8_t100ps.str
extract.profile axis=x y.val=0.01 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN092_094_geometry_reference/RUN092_t100ps_surface_all.csv
extract.profile axis=x y.val=0.35 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN092_094_geometry_reference/RUN092_t100ps_uid_sub_all.csv
extract.profile axis=y x.val=11.0 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN092_094_geometry_reference/RUN092_t100ps_track_all.csv

load in=/root/DECKBUILD/runs/RUN094_wang1000-nofp-lgd9-x11-reference/RUN094_Wang2026_nofp_Lgd9_x11_fulltrack_SEB_1000V_Et0p8_t100ps.str
extract.profile axis=x y.val=0.01 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN092_094_geometry_reference/RUN094_t100ps_surface_all.csv
extract.profile axis=x y.val=0.35 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN092_094_geometry_reference/RUN094_t100ps_uid_sub_all.csv
extract.profile axis=y x.val=11.0 fields=* regions=* csvfile=/root/DECKBUILD/postproc/RUN092_094_geometry_reference/RUN094_t100ps_track_all.csv

