	polygon="0,-0.18 0.5,-0.18 0.5,-0.17 0.5,-0.02 0.5,0 0,0"
#
constr.mesh region=10 default

region reg=11 name=drain mat=Nickel elec.id=2 work.func=0 color=0xffff96 pattern=0xe \
	polygon="15,0 14.5,0 14.5,-0.02 14.5,-0.17 14.5,-0.18 15,-0.18"
