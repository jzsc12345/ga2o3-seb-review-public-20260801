constr.mesh region=11 default

region reg=12 name=gate mat=Nickel elec.id=3 work.func=0 color=0xffff96 pattern=0xe \
	polygon="6,-0.2 6,-0.17 4,-0.17 4,-0.12 2,-0.12 2,-0.17 1.5,-0.17 1.5,-0.2"
#
constr.mesh region=12 default


