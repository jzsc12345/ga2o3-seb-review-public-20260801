+# ================= SEB CONTROL BLOCK =================
+# Normal-incidence strike in the gate-drain drift region.
+# xion=10.25 um is the midpoint between the gate edge (x=6.0 um)
+# and the drain-side metal edge (x=14.5 um).
+# IMPORTANT: xion must equal x0 in mySEU_bv.c.
+set xion=10.25
+
+# Progressive DevEdit refinement windows translated from SEB(4).in.
+# Arithmetic is resolved once here so the entire strike mesh moves with xion.
+set ion_outer_x1=$xion-1.288
+set ion_outer_x2=$xion+1.759
+set ion_coarse_x1=$xion-0.826
+set ion_coarse_x2=$xion+0.859
+set ion_medium_x1=$xion-0.547
+set ion_medium_x2=$xion+0.666
+set ion_inner_x1=$xion-0.250
+set ion_inner_x2=$xion+0.302
+set ion_finest_x1=$xion-0.204
+set ion_finest_x2=$xion+0.226
+# =====================================================
