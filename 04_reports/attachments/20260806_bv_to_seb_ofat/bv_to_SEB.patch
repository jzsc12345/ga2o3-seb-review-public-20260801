+refine mode=x x1=$ion_medium_x1 y1=0.0 x2=$ion_medium_x2 y2=0.6
+refine mode=x x1=$ion_inner_x1  y1=0.0 x2=$ion_inner_x2  y2=0.6
+refine mode=x x1=$ion_finest_x1 y1=0.0 x2=$ion_finest_x2 y2=0.6
 
