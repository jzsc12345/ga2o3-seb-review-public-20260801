structure outf=VM_SEB_STAGE2_devedit_raw.str

# ----------------------------------------------------------------------
# Victory Mesh Stage 2: same conformal route plus the frozen track grid.
# Outside x=10.10..10.40 um, x spacing remains the Stage 1 baseline.
# The conformal Cartesian grid necessarily shares y planes across x, but
# does not impose the fine track x spacing on the rest of the device.
# ----------------------------------------------------------------------
go victorymesh simflags="-P 4"

load in="VM_SEB_STAGE2_devedit_raw.str"

info
info fields="*"

# Baseline geometry-boundary planes, unchanged from Stage 1.
line x location=0.0  spacing=0.10
line x location=0.5  spacing=0.02
line x location=1.0  spacing=0.02
line x location=1.5  spacing=0.02
line x location=2.0  spacing=0.02
line x location=4.0  spacing=0.02
line x location=6.0  spacing=0.02
line x location=14.0 spacing=0.05
line x location=14.5 spacing=0.02
line x location=15.0 spacing=0.10

# Track x planes: radius is resolved by multiple columns, not one center line.
line x location=10.10 spacing=0.015
line x location=10.25 spacing=0.015
line x location=10.40 spacing=0.015

# Geometry/interface y planes; the semiconductor depth is capped at 0.015 um.
line y location=-0.20 spacing=0.010
line y location=-0.18 spacing=0.005
line y location=-0.17 spacing=0.005
line y location=-0.12 spacing=0.005
line y location=-0.07 spacing=0.005
line y location=-0.02 spacing=0.005
line y location=0.00  spacing=0.005
line y location=0.15  spacing=0.015
line y location=0.20  spacing=0.015
line y location=0.40  spacing=0.015
line y location=0.60  spacing=0.015

remesh conformal

save out="VM_SEB_STAGE2_conformal_track_x10p25.str" mode=atlas

quit
